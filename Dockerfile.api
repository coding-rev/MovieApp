# ---------- Build stage ----------
FROM node:20-alpine AS builder
WORKDIR /app

# 1) Install workspace deps
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/types/package*.json ./packages/types/
RUN npm ci

# 2) Copy sources
COPY . .

# 3) Build shared package then generate Prisma client for POSTGRES schema
#    Using workspace-qualified npx so paths are correct in a monorepo.
RUN npm run -w packages/types build
RUN npx -w apps/api prisma generate --schema ./prisma/postgres/schema.prisma

# 4) Build API
RUN npm run -w apps/api build


# ---------- Runtime stage ----------
FROM node:20-alpine AS production
WORKDIR /app

# 1) Install *production* deps for the monorepo
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/types/package*.json ./packages/types/
RUN npm ci --omit=dev

# 2) Copy built artifacts + pre-generated Prisma client
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/types/package.json ./packages/types/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
# Copy the generated client + engines from builder so we don't need to run generate again
COPY --from=builder /app/apps/api/node_modules/@prisma/client ./apps/api/node_modules/@prisma/client
COPY --from=builder /app/apps/api/node_modules/.prisma ./apps/api/node_modules/.prisma

# 3) (Optional but recommended) Install Prisma CLI *only* in API workspace
#    so we can run migrations at startup. If you prefer a separate "migrate" job,
#    you can omit this line and use that job instead.
RUN npm i -w apps/api prisma --no-save

WORKDIR /app/apps/api
EXPOSE 4000

# 4) Run migrations then start the server
#    PRISMA_SCHEMA is optional if you put the schema in default location,
#    but here we’re being explicit.
ENV PRISMA_SCHEMA=./prisma/postgres/schema.prisma
CMD sh -c "npx prisma migrate deploy --schema $PRISMA_SCHEMA && node dist/server.js"
