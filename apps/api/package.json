{
  "name": "@full-stack-interview/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "db:seed:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- tsx ./prisma/seed.ts",
    "db:seed:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- tsx ./prisma/seed.ts",
    
    "dev": "npm run prisma:generate:dev && npm run prisma:migrate:dev && npm run db:seed:dev && tsx watch ./src/server.ts",
    "prod": "npm run prisma:generate:prod && npm run prisma:migrate:prod && npm run db:seed:prod && tsx watch ./src/server.ts",

    "test:prod": "npm run prisma:generate:prod && cross-env NODE_ENV=production dotenv -e .env.production -- vitest run --coverage",
    "test:watch:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- vitest watch",

    "test:dev": "npm run prisma:generate:dev &&  cross-env NODE_ENV=development dotenv -e .env.development -- vitest run --coverage",
    "test:watch:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- vitest watch",
    
    "typecheck": "tsc -p tsconfig.json",
    
    "prisma:generate:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- prisma generate --schema ./prisma/postgres/schema.prisma",
    "prisma:migrate:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- prisma migrate deploy --schema ./prisma/postgres/schema.prisma",
    
    "prisma:generate:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- prisma generate --schema ./prisma/sqlite/schema.prisma",
    "prisma:migrate:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- prisma migrate dev --schema ./prisma/sqlite/schema.prisma",

    "build": "npm run prisma:generate:prod && tsc -b tsconfig.build.json",
    "start": "npm run prisma:migrate:prod && node dist/server.js"
  },
  "dependencies": {
  "@full-stack-interview/types": "0.0.0",
    "@prisma/client": "^6.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vitest": "^4.0.0"
  }
}
