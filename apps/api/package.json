{
  "name": "@full-stack-interview/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:seed": "prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@full-stack-interview/types": "file:../../packages/types",
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "^5.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
